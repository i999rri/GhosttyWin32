<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GhosttyWin32.TerminalControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    AllowFocusOnInteraction="True"
    IsHitTestVisible="True">
    <!--
      Focus border: thin colored frame around the active pane in a
      multi-pane tab. BorderThickness stays at 1 regardless of focus
      state so toggling the colour doesn't force a layout pass /
      terminal grid reflow — only the BorderBrush flips between
      Transparent and the accent in the code-behind GotFocus /
      LostFocus handlers.
    -->
    <Border x:Name="FocusBorder"
            BorderThickness="1"
            BorderBrush="Transparent">
        <SwapChainPanel x:Name="Panel"
                        IsTabStop="False"
                        AllowFocusOnInteraction="False" />
    </Border>
</UserControl>
