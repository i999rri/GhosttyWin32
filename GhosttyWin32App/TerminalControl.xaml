<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GhosttyWin32.TerminalControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    AllowFocusOnInteraction="True"
    IsHitTestVisible="True">
    <!--
      Focus border is an overlay sibling, not a wrapper, so its 1 DIP
      thickness doesn't reserve permanent layout space around the
      SwapChainPanel (which would draw a visible gap between panes
      whether the border is colored or transparent). IsHitTestVisible
      stays false so input passes straight through to the
      SwapChainPanel underneath. BorderBrush flips between
      Transparent and the accent colour from code-behind, with a
      DispatcherTimer hiding it again after a short interval — see
      ShowFocusBorder().
    -->
    <Grid>
        <SwapChainPanel x:Name="Panel"
                        IsTabStop="False"
                        AllowFocusOnInteraction="False" />
        <Border x:Name="FocusBorder"
                BorderThickness="1"
                BorderBrush="Transparent"
                IsHitTestVisible="False" />
    </Grid>
</UserControl>
