<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GhosttyWin32.TerminalControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GhosttyWin32"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    AllowFocusOnInteraction="True"
    IsHitTestVisible="True">
    <!--
      One pane. The Grid stacks, bottom to top: the opaque underlay,
      the SwapChainPanel the SurfaceHost renders into, the unfocused
      dim, then the overlays — each its own UserControl so this file
      only decides z-order and the composite only decides routing.
      Every overlay is an in-tree sibling, never a popup (#61): a
      hit-test-transparent sibling cannot interfere with pointer
      routing to the panel, and the two that take input (scrollbar,
      search bar) only intercept inside their own narrow bounds.
    -->
    <Grid>
        <!--
          Opaque background underlay (#69). The renderer composites
          the swap chain with premultiplied alpha, so with
          background-opacity < 1 the pane is genuinely translucent.
          TOGGLE_BACKGROUND_OPACITY's "opaque" state shows this
          rectangle in the terminal's own background colour UNDER the
          swap chain: opacity*bg blended over solid bg equals bg
          exactly, so the pane reads as fully opaque — no renderer
          round-trip needed to toggle.
        -->
        <Rectangle x:Name="OpaqueUnderlay"
                   IsHitTestVisible="False"
                   Visibility="Collapsed" />
        <SwapChainPanel x:Name="Panel"
                        IsTabStop="False"
                        AllowFocusOnInteraction="False" />
        <!--
          UnfocusedDim is hit-test transparent so pointer events
          still reach the SwapChainPanel underneath. When the pane is
          not its tab's active split we show the rectangle filled
          with the `unfocused-split-fill` color (defaulting to the
          terminal background) at (1 - `unfocused-split-opacity`)
          alpha; the underlying surface stays at full brightness, the
          unfocused pane gets dimmed by the overlay. This mirrors how
          upstream ghostty (macOS SurfaceView, GTK unfocused-split
          style) marks the active leaf — the bright pane reads as
          "active" without the user having to find an explicit
          border.
        -->
        <Rectangle x:Name="UnfocusedDim"
                   IsHitTestVisible="False"
                   Visibility="Collapsed" />
        <local:PaneStatusOverlay x:Name="Status" />
        <local:SearchOverlay x:Name="Search" />
        <local:ScrollbackOverlay x:Name="Scrollback" />
    </Grid>
</UserControl>
