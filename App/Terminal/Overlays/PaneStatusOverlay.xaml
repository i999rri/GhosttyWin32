<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GhosttyWin32.PaneStatusOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="False"
    IsHitTestVisible="False">
    <!--
      Passive status overlays for one pane. Every element here is
      hit-test transparent by construction (the control itself is),
      so nothing in this file can interfere with pointer routing to
      the SwapChainPanel underneath — the reason these are in-tree
      siblings and not popups (#61: the original Win32 TOPMOST
      tooltip over the DComp surface crashed the process on URL
      click). Each overlay keeps its own corner so they never
      collide: link banner bottom-left, status badges top-right,
      key-state badge bottom-right.
    -->
    <Grid>
        <!--
          Status badges (top-right). Secure-input: ghostty's shell
          integration turns it on while a password prompt is active;
          the badge tells the user why their keystrokes deserve
          extra care. Read-only (toggle_readonly): the write
          blocking itself happens inside libghostty; without the
          chip the keyboard just "goes silent" with no explanation.
        -->
        <StackPanel Orientation="Horizontal"
                    Spacing="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
            <Border x:Name="ReadonlyBadge"
                    Visibility="Collapsed"
                    CornerRadius="0,0,6,6"
                    Padding="8,4,8,4"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                <TextBlock FontSize="12"
                           Text="read-only"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Border>
            <Border x:Name="SecureInputBadge"
                    Visibility="Collapsed"
                    CornerRadius="0,0,0,6"
                    Padding="8,4,8,4"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                <TextBlock FontSize="12"
                           Text="&#x1F512;"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Border>
        </StackPanel>
        <!--
          Key-state badge (KEY_SEQUENCE / KEY_TABLE). Shows the
          active key-table stack and/or the pending multi-chord
          triggers so a user mid-sequence can see why their keys
          aren't typing.
        -->
        <Border x:Name="KeyStateBadge"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                CornerRadius="6,0,0,0"
                Padding="8,4,8,4"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <TextBlock x:Name="KeyStateBadgeText"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </Border>
        <!--
          Hovered-link banner (issue #61). Mirrors upstream's bottom-
          corner URL display (macOS URLHoverBanner / GTK
          mouse-hover-url label).
        -->
        <Border x:Name="LinkBanner"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                CornerRadius="0,6,0,0"
                Padding="8,4,8,4"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <TextBlock x:Name="LinkBannerText"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </Border>
    </Grid>
</UserControl>
