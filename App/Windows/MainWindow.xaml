<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GhosttyWin32.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GhosttyWin32"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Ghostty">

    <!-- Layout strategy:
           Row 0  AppTitleBar (Auto height) — the entire chrome area:
                  TabView's tab strip on the left, caption buttons pinned
                  on the right. Hidden as a unit when chrome is turned off
                  (planned follow-up for `window-decoration=false`).
           Row 1  AppContent (Star) — terminal content area. Every Tab's
                  SplitPanel is parented here (not in TabViewItem.Content)
                  so the strip can live above without coupling its
                  visibility to whether the terminal stays visible.
                  Selection drives per-panel Visibility; tab switching
                  toggles which child of AppContent is Visible.
         Inside AppTitleBar:
           Col 0  TabView (spans both columns) — strip-only, since the
                  per-tab Content is hosted in AppContent. With null
                  TabItem.Content the template's content row collapses to
                  zero, so the Auto outer row sizes to just the strip.
           Col 1  CaptionButtons (Auto ≈ 138px) — anchored right in the
                  outer Grid so they don't shift when the TabStripFooter
                  width changes; drawn on top of the strip via Z-order.
         The TabStripFooter hosts the new-tab menu button (the template
         places the footer right after the built-in "+", so it sits
         beside it like Windows Terminal's dropdown) followed by a
         DragRegion border (MinWidth=200 leaves ~62px of empty draggable
         area to the left of the caption buttons). The drag rect handed
         to the OS is DragRegion's bounds only (SetDragRectangles), so
         the button takes clicks like the caption buttons do. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <!-- Styles and brushes for the title bar's own buttons. Merged
                 here rather than app-wide: the dictionary shadows the
                 default Button template's hover / pressed fills for every
                 Button in scope, and only these buttons want the flat
                 look. TabView's internal buttons use their own keys. -->
            <Grid.Resources>
                <ResourceDictionary Source="ms-appx:///Styles/TitleBarButtons.xaml" />
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TabView x:Name="TabView" Grid.Column="0" Grid.ColumnSpan="2"
                     IsAddTabButtonVisible="True"
                     CanDragTabs="True"
                     TabWidthMode="Equal"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Stretch">
                <TabView.TabStripFooter>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Opens the menu of tab kinds below itself. The
                             "+" next to it duplicates the active tab's kind
                             instead. Focus is kept off it for the same
                             reason as the caption buttons and the "+".
                             Style and geometry are copied from the
                             template's AddButton once it exists (see
                             MatchNewTabMenuButtonTo) so the two read as
                             siblings; the values here only cover the
                             frames before that. -->
                        <Button x:Name="NewTabMenuButton" Grid.Column="0"
                                Width="32" Height="24" Padding="0"
                                BorderThickness="0" CornerRadius="4"
                                Background="Transparent"
                                VerticalAlignment="Bottom"
                                IsTabStop="False" AllowFocusOnInteraction="False"
                                ToolTipService.ToolTip="New tab...">
                            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                      Glyph="&#xE70D;" FontSize="12" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuFlyoutItem Text="New Tab" Click="OnNewTabMenuDefaultClick" />
                                    <MenuFlyoutItem Text="New WSL Tab" Click="OnNewTabMenuWslClick" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Border x:Name="DragRegion" Grid.Column="1"
                                Background="Transparent"
                                HorizontalAlignment="Stretch"
                                MinWidth="200" />
                    </Grid>
                </TabView.TabStripFooter>
            </TabView>

            <!-- Caption buttons (Styles/TitleBarButtons.xaml). Glyphs are
                 Segoe icon code points as Content; the style sets the
                 icon font. -->
            <StackPanel x:Name="CaptionButtons" Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}"
                        Content="&#xE921;" Click="OnMinimizeClick" />
                <!-- Content swaps between Maximize (E922) and Restore
                     (E923) in UpdateMaximizeGlyph. -->
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}"
                        Content="&#xE922;" Click="OnMaximizeClick" />
                <!-- Close takes Windows' red hover: the dictionary's
                     CaptionClose* brushes aliased onto the template's keys. -->
                <Button x:Name="CloseButton" Style="{StaticResource CaptionButtonStyle}"
                        Content="&#xE8BB;" Click="OnCloseClick">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="CaptionCloseBackgroundPointerOver" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="CaptionCloseBackgroundPressed" />
                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="CaptionCloseForeground" />
                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="CaptionCloseForeground" />
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- AppContent: every Tab's SplitPanel is appended here as a
             child (not as TabViewItem.Content). The currently-selected
             tab's panel is the only one with Visibility=Visible; the
             rest are Collapsed but stay parented so their swap chains
             keep their DComp surface binding across tab switches. -->
        <Grid x:Name="AppContent" Grid.Row="1" />

        <!-- Window-level command palette (#205): one per window,
             overlaid on the content area; entries execute against
             the active pane. Collapsed except while open. -->
        <local:CommandPalette x:Name="PaletteOverlay" Grid.Row="1" />
    </Grid>
</Window>
