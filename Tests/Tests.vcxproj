  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!--
    Tests.exe links against ghostty-internal.lib (import library)
    and loads ghostty-internal.dll at run time. The App project
    ships the dll via the MSIX packaging path; standalone Tests.exe
    doesn't, so the OutDir stays missing the dll and the EXE fails
    at startup with "cannot open shared object file". Copy the dll
    next to the test EXE after every build so direct execution
    (and Test Explorer's runner) finds it.
  -->
  <Target Name="CopyGhosttyDllToOutput" AfterTargets="Build">
    <!--
      The on-disk artifact is ghostty-internal.dll but the import
      lib's descriptor encodes the PE internal name (ghostty.dll),
      so the EXE's import table resolves ghostty.dll at startup —
      copy the file under that name to satisfy it.
    -->
    <Copy SourceFiles="$(ProjectDir)..\external\ghostty\zig-out\lib\ghostty-internal.dll"
          DestinationFiles="$(OutDir)ghostty.dll"
          SkipUnchangedFiles="true" />
  </Target>
